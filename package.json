{
  "name": "belay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first control plane for heterogeneous coding agent fleets.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codersguru-hub/Belay.git"
  },
  "homepage": "https://github.com/codersguru-hub/Belay#readme",
  "bugs": {
    "url": "https://github.com/codersguru-hub/Belay/issues"
  },
  "bin": {
    "belay": "./bin/belay.js"
  },
  "workspaces": [
    "packages/contracts",
    "packages/cloud-service",
    "packages/dashboard",
    "packages/daemon"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspace @belay/daemon",
    "start": "node bin/belay.js start",
    "init": "node bin/belay.js init",
    "doctor": "node bin/belay.js doctor",
    "test": "npm run build && vitest run",
    "benchmark:indexer": "npm run build && node scripts/benchmark-indexer.mjs",
    "smoke:phase1": "node --experimental-strip-types scripts/smoke-phase1.ts",
    "demo:request-approval": "node scripts/request-demo-approval.mjs",
    "demo:request-vault-approval": "node scripts/request-demo-vault-approval.mjs",
    "demo:verify": "npm run build && vitest run tests/hero-demo.integration.test.ts --reporter=verbose",
    "smoke:cloud": "node scripts/smoke-cloud.mjs",
    "verify:no-leaks": "npm run build && vitest run tests/executor.security.test.ts tests/cloud-egress.integration.test.ts tests/hero-demo.integration.test.ts --reporter=verbose",
    "demo:seed": "node scripts/seed-demo.mjs",
    "render:video": "node scripts/build-video.mjs",
    "render:check": "node scripts/build-video.mjs --check",
    "demo:check": "node scripts/demo-director.mjs --check",
    "demo:direct": "node scripts/demo-director.mjs",
    "demo:prompter": "node scripts/demo-director.mjs --prompter"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "playwright": "^1.62.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
